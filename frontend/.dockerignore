# ── Dependencies (re-installed inside the image) ──────────────────────────────
node_modules
.pnp
.pnp.js

# ── Build output (re-generated inside the image) ──────────────────────────────
.next
out

# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Environment files — never bake secrets into the image ─────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production

# ── Editor / OS artefacts ─────────────────────────────────────────────────────
.DS_Store
.idea
.vscode
*.swp
*.swo
Thumbs.db

# ── Test output ───────────────────────────────────────────────────────────────
coverage
.nyc_output

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker files themselves ───────────────────────────────────────────────────
Dockerfile
.dockerignore

# ── Documentation ─────────────────────────────────────────────────────────────
*.md